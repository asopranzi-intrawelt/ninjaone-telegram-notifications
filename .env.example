# Istanza NinjaOne: eu | us | ca | us2 | fed | oc (vedi la regione del tuo account)
NINJAONE_INSTANCE=eu

# App API creata in NinjaOne: Amministrazione -> App -> API -> Client app IDs
# Scope consigliato: monitoring (sola lettura, sufficiente per leggere gli alert)
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
NINJAONE_SCOPE=monitoring
NINJAONE_ORGANIZATION_IDS=

# Bot Telegram creato via @BotFather
TELEGRAM_BOT_TOKEN=

# ID della chat di destinazione: negativo per gruppi/supergruppi (es. -1001234567890)
TELEGRAM_CHAT_ID=

# Solo se il gruppo e' una supergroup con Topic abilitati: ID del topic di destinazione
TELEGRAM_MESSAGE_THREAD_ID=

# ID numerici Telegram dei due utenti da menzionare, separati da virgola
TELEGRAM_MENTION_USER_IDS=

# Filtro di criticita': solo alert con severity in questo elenco (maiuscolo, separati da
# virgola) vengono notificati. Vuoto = nessun filtro, tutti gli alert attivi passano.
# I valori sotto (CRITICAL, MAJOR) sono presunti sui nomi tipici usati da NinjaOne: non ancora
# verificati contro un'istanza reale. Calibrare cosi': lasciare vuoto il filtro per i primi
# alert reali, leggere nei log la riga "severity osservate: [...]", poi valorizzare questa
# variabile con i valori effettivi.
NINJAONE_MIN_SEVERITIES=CRITICAL,MAJOR

# Intervallo di polling in secondi
POLL_INTERVAL_SECONDS=120

# Percorso del file locale che tiene traccia degli alert gia' notificati
STATE_FILE_PATH=./data/seen_alerts.json
